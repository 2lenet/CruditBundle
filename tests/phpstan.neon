includes:
    - ../vendor/phpstan/phpstan-phpunit/extension.neon
    - ../vendor/phpstan/phpstan-mockery/extension.neon
    - ../vendor/phpstan/phpstan-symfony/extension.neon
    - ../vendor/phpstan/phpstan-symfony/rules.neon
    - ../vendor/phpstan/phpstan-doctrine/extension.neon
    - ../vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 8
    paths:
        - ../src
        - ../tests
    excludePaths:
        - '../src/Resources/skeleton'
        - '../tests/apps'
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            identifier: missingType.generics
        -
            identifier: trait.unused
            paths:
                - ../src/Controller/TraitCrudController.php
                - ../src/Test/
        # Types::SIMPLE_ARRAY is deprecated in recent doctrine/dbal, but still handled for existing mappings
        -
            identifier: classConstant.deprecated
            path: ../src/Form/DoctrineOrmTypeGuesser.php
            reportUnmatched: false
        # The mutable date types are still the mapping of existing entities: the Maker recognises them
        -
            identifier: classConstant.deprecated
            path: ../src/Maker/MakeCrudit.php
            reportUnmatched: false
        # Type::getType(), hasType(), addType() are deprecated since doctrine/dbal 4.6 (type provider of the connection),
        # which does not exist in the 3.x still supported
        -
            identifier: staticMethod.deprecated
            paths:
                - ../src/Filter/EntityIdentifiers.php
                - ../tests/phpunit/Unit/Filter/EntityIdentifiersTest.php
            reportUnmatched: false
