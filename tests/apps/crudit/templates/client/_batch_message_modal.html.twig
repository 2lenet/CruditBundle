{#
 # A modal of free content for a batch action (lot 3.1.c): setModal() + setIsBatch(). Its form has the fields
 # data-selection-field="ids" and "all_page": the SelectionBar fills them when the dialog opens.
 # Variables: id (the one of the modal), action, params.
 #}
{% extends '@LleCrudit/modal/_base_modal.html.twig' %}

{% block header %}{{ 'client.batch_message.title'|trans }}{% endblock %}
{% block body %}
    <form id="{{ id }}-form" method="post" action="{{ path(action.path.route, params) }}">
        <input type="hidden" name="ids" data-selection-field="ids">
        <input type="hidden" name="all_page" data-selection-field="all_page">
        <p>
            <label for="{{ id }}-message">{{ 'client.email.message'|trans }}</label><br>
            <textarea id="{{ id }}-message" name="message" rows="3" required></textarea>
        </p>
    </form>
{% endblock %}
{% block footer %}
    <twig:LleCruditUi:Button commandfor="{{ id }}" command="close">{{ 'client.email.cancel'|trans }}</twig:LleCruditUi:Button>
    <twig:LleCruditUi:Button variant="primary" type="submit" form="{{ id }}-form">{{ 'client.email.send'|trans }}</twig:LleCruditUi:Button>
{% endblock %}
