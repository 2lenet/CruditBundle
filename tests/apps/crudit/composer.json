{
    "type": "project",
    "description": "Test application of CruditBundle: the bundle installed as a project does, driven by PHPUnit and a headless Chrome",
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "2lenet/crudit-bundle": "@dev",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "php": ">=8.4",
        "phpdocumentor/reflection-docblock": "^5.3",
        "symfony/asset": "^8.0",
        "symfony/asset-mapper": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/intl": "^8.0",
        "symfony/maker-bundle": "^1.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/stimulus-bundle": "^3.0",
        "symfony/translation": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/ux-icons": "^3.5",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "^8.0",
        "symfony/workflow": "^8.0",
        "symfony/yaml": "^8.0",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^8.0",
        "symfony/css-selector": "^8.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "name": "crudit",
            "type": "path",
            "url": "../../../",
            "options": {
                "symlink": false,
                "versions": {
                    "2lenet/crudit-bundle": "2.0.0-dev"
                }
            }
        }
    ]
}
