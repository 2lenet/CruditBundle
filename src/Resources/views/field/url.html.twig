{% if
    (view.field.editInPlace and (view.isEditable is not defined or view.isEditable(resource)) and view.field.options['editRole'] is not defined)
    or (view.field.editInPlace and (view.isEditable is not defined or view.isEditable(resource)) and view.field.options['editRole'] is defined and is_granted(view.field.options['editRole'], resource))
%}
    {% set edit_url = path(view.field.options['edit_route'], {'id': resource.id}) %}
    <div class="crudit-eip" data-field="{{ view.field.id }}" data-edit_url="{{ edit_url }}">
        <form class="form-inline d-none">
            <div class="control-group form-group d-flex justify-content-around align-items-center">
                <input type="text" class="form-control form-control-sm crudit-eip-input" style="min-width: 150px;"
                       autocomplete="off" value="{{ value }}">
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-primary crudit-eip-submit">
                        <i class="fa fa-check"></i>
                    </button>
                    <button type="button" class="btn btn-danger crudit-eip-cancel">
                        <i class="fa fa-close"></i>
                    </button>
                </div>
            </div>
            <div class="editable-error-block help-block" style="display: none;"></div>
        </form>
        <div class="crudit-eip-value">
            <a href="{{ value }}" target="_blank">{{ value }}</a>
        </div>
    </div>
{% else %}
    <span class="crudit-value crudit-value--url">
    {%- block value -%}
        {%- if value is null or value is same as('') or (value is iterable and value is empty) -%}
            {{ include('@LleCrudit/field/_empty.html.twig') }}
        {%- else -%}
            {#- Shown without its scheme nor www.; its host, then its path (hidden in a cell of a table); a link only for
             # http(s), never javascript: -#}
            {%- set shown = value|split('://', 2)|last -%}
            {%- set shown = shown starts with 'www.' ? shown|slice(4) : shown -%}
            {%- set host = shown|split('/', 2)|first -%}
            {%- set path = shown|slice(host|length) -%}
            {%- if value starts with 'https://' or value starts with 'http://' -%}
                <a class="crudit-value__link" href="{{ value }}" target="_blank" rel="noopener noreferrer">
                    <span class="crudit-value__host">{{ host }}</span>{% if path %}<span class="crudit-value__path">{{ path }}</span>{% endif %}{{ ui_icon('external-link', 'crudit-value__external') }}<span class="crudit-ui-visually-hidden"> {{ 'crudit.field.new_tab'|trans(domain: 'LleCruditBundle') }}</span>
                </a>
            {%- else -%}
                {{ shown }}
            {%- endif -%}
        {%- endif -%}
    {%- endblock -%}
    </span>
{% endif %}
