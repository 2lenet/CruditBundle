{% if
    (view.field.editInPlace and (view.isEditable is not defined or view.isEditable(resource)) and view.field.options['editRole'] is not defined)
    or (view.field.editInPlace and (view.isEditable is not defined or view.isEditable(resource)) and view.field.options['editRole'] is defined and is_granted(view.field.options['editRole'], resource))
%}
    {% set edit_url = path(view.field.options['edit_route'], {'id': resource.id}) %}
    <div class="crudit-eip" data-field="{{ view.field.id }}" data-edit_url="{{ edit_url }}">
        <div class="form-check form-switch {% if options.reverseColors %}form-switch--reverse-colors{% endif %}">
            <input
                class="form-check-input crudit-eip-input crudit-eip-submit"
                type="checkbox"
                autocomplete="off"
                id="{{ view.field.id }}" {% if value == true %}checked{% endif %}>
        </div>
    </div>
{% else %}
    <span class="crudit-value crudit-value--bool">
    {%- block value -%}
        {#- null: a dash, or No with nullToFalse; reverseColors: Yes in danger, No in success -#}
        <twig:LleCruditUi:Boolean :value="value is null and options.nullToFalse ? false : (value is null ? null : (value ? true : false))" :reverse="options.reverseColors"/>
    {%- endblock -%}
    </span>
{% endif %}
