{% if options['isInt'] is defined and options['isInt'] and value is not null %}
    {% set value =  value / 100 %}
{% endif %}
{% if
    (view.field.editInPlace and (view.isEditable is not defined or view.isEditable(resource)) and view.field.options['editRole'] is not defined)
    or (view.field.editInPlace and (view.isEditable is not defined or view.isEditable(resource)) and view.field.options['editRole'] is defined and is_granted(view.field.options['editRole'], resource))
%}
    {% set edit_url = path(view.field.options['edit_route'], {
        id: resource.id,
        options: {
            (view.field.id) : {
                currency: options['isInt'] is defined and options['isInt'] ? 'currency_int' : 'currency_float'
            }
        }
    }) %}
    <div class="crudit-eip" data-field="{{ view.field.id }}" data-edit_url="{{ edit_url }}">
        <form class="form-inline d-none">
            <div class="control-group form-group d-flex justify-content-around align-items-center">
                <input type="number" class="form-control form-control-sm crudit-eip-input" style="min-width: 100px;"
                       autocomplete="off" value="{{ value }}" step="0.01">
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-primary crudit-eip-submit">
                        <i class="fa fa-check"></i>
                    </button>
                    <button type="button" class="btn btn-danger crudit-eip-cancel">
                        <i class="fa fa-close"></i>
                    </button>
                </div>
            </div>
            <div class="editable-error-block help-block" style="display: none;"></div>
        </form>
        <div class="crudit-eip-value">{{ value }}</div>
    </div>
{% else %}
    {%- if value is not crudit_empty -%}
        {%- if options.property -%}
            {%- set currency = options.property|split('.')|reduce((object, property) => object ? attribute(object, property) : null, resource) -%}
        {%- else -%}
            {%- set currency = options.currency -%}
        {%- endif -%}
        {%- set result = options.locale ? value|format_currency(currency, options.params, options.locale) : value|ui_currency(currency, options.params) -%}
    {%- endif -%}
    {%- if options.removeHtml -%}
        {{ result ?? '' }}
    {%- else -%}
    <span class="crudit-value crudit-value--currency">
    {%- block value -%}
        {%- if value is crudit_empty -%}
            {{ include('@LleCrudit/field/_empty.html.twig') }}
        {%- else -%}
            {{ result }}
        {%- endif -%}
    {%- endblock -%}
    </span>
    {%- endif -%}
{% endif %}
