{# The error sits on the compound field: forward its state to the "+33" box and the number input #}
{% set country = form.country %}
{% set code = '' %}
{%- for choice in country.vars.preferred_choices|merge(country.vars.choices) -%}
    {%- if choice.value is defined and choice.value == country.vars.value -%}
        {%- set code = choice.attr['data-code'] -%}
    {%- endif -%}
{%- endfor -%}
<div id="{{ id }}" class="input-group crudit-telephone">
    {# Compact "+33" box: the native select lies transparent over it, keeping the full country list and keyboard #}
    <div class="crudit-telephone-calling-code form-select{{ form.vars.valid ? '' : ' is-invalid' }}">
        <span class="crudit-telephone-code" aria-hidden="true">{{ code }}</span>
        {{ form_widget(country, {
            attr: country.vars.attr|merge({'aria-label': 'crudit.telephone.calling_code'|trans({}, 'LleCruditBundle')}),
        }) }}
    </div>
    {{ form_widget(form.number, {valid: form.vars.valid}) }}
</div>
