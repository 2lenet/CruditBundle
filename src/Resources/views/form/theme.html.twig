{#
 # Form theme of Crudit (lot 3.2.a): the inputs of CruditUiBundle (@LleCruditUi/form/theme.html.twig, no Bootstrap),
 # and the blocks of the Crudit form types. Registered in twig.form.resources (the Crudit types work in the forms of
 # the project), and imposed by the bricks whatever the global theme of the project:
 # {% form_theme form with ['@LleCrudit/form/theme.html.twig'] only %}.
 # The layout of a form (sections, grid, widths) is in brick/form/index.html.twig.
 #}
{% use '@LleCruditUi/form/theme.html.twig' %}

{#
 # Format helpers of the 1.x (classes crudit-upper-format, crudit-lower-format, crudit-email-format, crudit-ip-format
 # on a field): the controller input-format, which acts once the field is left (lot 3.2.b). No spell check on an
 # e-mail or an IP address, the keyboard of an e-mail address (an IP address keeps the keyboard of a text, which has
 # the point).
 #}
{%- block form_widget_simple -%}
    {%- set attr = crudit_form_format_attr(attr) -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = crudit_form_format_attr(attr) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{#
 # A checkbox with the option switch (SwitchExtension, a boolean guessed by Crudit): role="switch" here only, the switch
 # of CruditUiBundle; another theme keeps the checkbox. The attr of the project keeps its role.
 #}
{%- block checkbox_row -%}
    {%- if switch|default(false) %}{% set attr = {role: 'switch'}|merge(attr) %}{% endif -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- if switch|default(false) %}{% set attr = {role: 'switch'}|merge(attr) %}{% endif -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{# The help of the options tooltip, tooltip_html and tooltip_template: a button next to the label #}
{%- block crudit_ui_label_after -%}
    {%- if tooltip|default(null) or tooltip_html|default(null) or tooltip_template|default(null) -%}
        {{- include('@LleCrudit/brick/form/_tooltip.html.twig', {field: form}) -}}
    {%- endif -%}
{%- endblock -%}

{# An entity in a list with search (AutocompleteType): the list of CruditUiBundle, its choices asked to the server #}
{%- block autocomplete_widget -%}
    {{- block('crudit_ui_combobox_widget') -}}
{%- endblock autocomplete_widget -%}

{% block crudit_gedmo_translatable_widget %}
    {% include '@LleCrudit/form/_gedmo_translatable_widget.html.twig' %}
{% endblock %}

{% block crudit_group_row %}
{% endblock %}

{% block crudit_group_label %}
{% endblock %}

{#
 # A file of VichUploaderBundle (VichFileType, VichImageType, the FileType of Crudit): the file of CruditUiBundle (a drop
 # zone covered by the input, the file chosen listed), with the file already sent (VichFileExtension): its name, its
 # size when the mapping keeps it, its preview when the type gives an image_uri and the file is an image (VichImageType,
 # the FileType of Crudit; not VichFileType: its public uri may not be served), a link Download (download_uri) and,
 # with allow_delete, a button Delete that checks the checkbox delete of Vich, hidden. The label points to the input;
 # the help and the error of the field are attached to it.
 #}
{%- block crudit_file_row -%}
    {{- block('crudit_vich_row') -}}
{%- endblock crudit_file_row -%}

{%- block vich_file_row -%}
    {{- block('crudit_vich_row') -}}
{%- endblock vich_file_row -%}

{%- block vich_image_row -%}
    {{- block('crudit_vich_row') -}}
{%- endblock vich_image_row -%}

{%- block crudit_vich_row -%}
    {%- set row_class = ('crudit-ui-field' ~ (errors|length > 0 ? ' crudit-ui-field--invalid' : '') ~ ' ' ~ row_attr.class|default(''))|trim -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {%- if label is not same as(false) -%}
            <div class="crudit-ui-field__label-row">
                {{- form_label(form, null, {compound: false, id: form.file.vars.id}) -}}
                {{- block('crudit_ui_label_after') -}}
            </div>
        {%- endif -%}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock crudit_vich_row -%}

{%- block crudit_file_widget -%}
    {{- block('crudit_vich_widget') -}}
{%- endblock crudit_file_widget -%}

{%- block vich_file_widget -%}
    {{- block('crudit_vich_widget') -}}
{%- endblock vich_file_widget -%}

{%- block vich_image_widget -%}
    {{- block('crudit_vich_widget') -}}
{%- endblock vich_image_widget -%}

{%- block crudit_vich_widget -%}
    {%- set crudit_described = (form.file.vars.attr['aria-describedby'] ?? '')|split(' ')|filter(v => v != '') -%}
    {%- if help is not empty %}{% set crudit_described = crudit_described|merge([id ~ '_help']) %}{% endif -%}
    {%- set crudit_file_attr = form.file.vars.attr -%}
    {%- if errors|length > 0 -%}
        {%- set crudit_described = crudit_described|merge([id ~ '_error']) -%}
        {%- set crudit_file_attr = crudit_file_attr|merge({'aria-invalid': 'true'}) -%}
    {%- endif -%}
    {%- if crudit_described is not empty %}{% set crudit_file_attr = crudit_file_attr|merge({'aria-describedby': crudit_described|join(' ')}) %}{% endif -%}
    {%- set crudit_input -%}{{ form_widget(form.file, {crudit_ui_file_input_only: true, attr: crudit_file_attr}) }}{%- endset -%}
    {%- set crudit_current = null -%}
    {%- if crudit_file_current|default(null) is not null -%}
        {%- set crudit_asset = asset_helper|default(false) is same as(true) -%}
        {%- set crudit_download = download_uri|default(null) -%}
        {%- if crudit_download is not empty and crudit_download is not same as(true) and crudit_asset %}{% set crudit_download = asset(crudit_download) %}{% endif -%}
        {#- A preview of an image only, from image_uri (VichImageType, the FileType of Crudit): never the public uri of the
         # storage, which a private mapping or a download_route does not serve -#}
        {%- set crudit_image = (crudit_file_current.mime_type ?? '') starts with 'image/' or crudit_file_current.name matches '/\\.(png|jpe?g|gif|svg|webp|avif)$/i' -%}
        {%- set crudit_preview = image_uri|default(null) is not empty and ('vich_image' in block_prefixes or crudit_image)
            ? image_uri : null -%}
        {%- if crudit_preview is not empty and crudit_asset %}{% set crudit_preview = asset(crudit_preview) %}{% endif -%}
        {%- set crudit_current = {
            name: crudit_file_current.name,
            size: crudit_file_current.size,
            download: crudit_download is empty or crudit_download is same as(true) ? null : crudit_download,
            preview: crudit_preview,
        } -%}
    {%- endif -%}
    {%- set crudit_delete = null -%}
    {%- if form.delete is defined -%}
        {%- set crudit_delete = form.delete.vars.full_name -%}
        {%- do form.delete.setRendered -%}
    {%- endif -%}
    {{- include('@LleCruditUi/form/_file.html.twig', {
        input: crudit_input,
        invalid: errors|length > 0,
        disabled: disabled,
        current: crudit_current,
        delete: crudit_current is null ? null : crudit_delete,
    }, with_context: false) -}}
{%- endblock crudit_vich_widget -%}

{% block crudit_cron_expression_widget %}
    {% include '@LleCrudit/form/_cron_expression_widget.html.twig' %}
{% endblock %}

{% block crudit_telephone_widget %}
    {% include '@LleCrudit/form/_telephone_widget.html.twig' %}
{% endblock %}

{% block crudit_telephone_row %}
    {#- A <label> pointing to the number, instead of the <fieldset>/<legend> of a compound field -#}
    {%- set row_class = ('crudit-ui-field' ~ (errors|length > 0 ? ' crudit-ui-field--invalid' : '') ~ ' ' ~ row_attr.class|default(''))|trim -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        <div class="crudit-ui-field__label-row">
            {{- form_label(form, null, {compound: false, id: form.number.vars.id}) -}}
            {{- block('crudit_ui_label_after') -}}
        </div>
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

