{#
 # Form theme of Crudit (lot 3.2.a): the inputs of CruditUiBundle (@LleCruditUi/form/theme.html.twig, no Bootstrap),
 # and the blocks of the Crudit form types. Registered in twig.form.resources (the Crudit types work in the forms of
 # the project), and imposed by the bricks whatever the global theme of the project:
 # {% form_theme form with ['@LleCrudit/form/theme.html.twig'] only %}.
 # The layout of a form (sections, grid, widths) is in brick/form/index.html.twig.
 #}
{% use '@LleCruditUi/form/theme.html.twig' %}

{#
 # Format helpers of the 1.x (classes crudit-upper-format, crudit-lower-format, crudit-email-format, crudit-ip-format
 # on a field): the controller input-format, which acts once the field is left (lot 3.2.b). No spell check on an
 # e-mail or an IP address, the keyboard of an e-mail address (an IP address keeps the keyboard of a text, which has
 # the point).
 #}
{%- block form_widget_simple -%}
    {%- set attr = crudit_form_format_attr(attr) -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = crudit_form_format_attr(attr) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{#
 # A checkbox with the option switch (SwitchExtension, a boolean guessed by Crudit): role="switch" here only, the switch
 # of CruditUiBundle; another theme keeps the checkbox. The attr of the project keeps its role.
 #}
{%- block checkbox_row -%}
    {%- if switch|default(false) %}{% set attr = {role: 'switch'}|merge(attr) %}{% endif -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- if switch|default(false) %}{% set attr = {role: 'switch'}|merge(attr) %}{% endif -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{# The help of the options tooltip, tooltip_html and tooltip_template: a button next to the label #}
{%- block crudit_ui_label_after -%}
    {%- if tooltip|default(null) or tooltip_html|default(null) or tooltip_template|default(null) -%}
        {{- include('@LleCrudit/brick/form/_tooltip.html.twig', {field: form}) -}}
    {%- endif -%}
{%- endblock -%}

{% block autocomplete_widget %}
    {% include '@LleCrudit/form/_autocomplete_widget.html.twig' %}
{% endblock %}

{% block crudit_gedmo_translatable_widget %}
    {% include '@LleCrudit/form/_gedmo_translatable_widget.html.twig' %}
{% endblock %}

{% block crudit_group_row %}
{% endblock %}

{% block crudit_group_label %}
{% endblock %}

{% block crudit_file_widget %}
    {% include '@LleCrudit/form/_file_widget.html.twig' %}
{% endblock %}

{% block crudit_cron_expression_widget %}
    {% include '@LleCrudit/form/_cron_expression_widget.html.twig' %}
{% endblock %}

{% block crudit_telephone_widget %}
    {% include '@LleCrudit/form/_telephone_widget.html.twig' %}
{% endblock %}

{% block crudit_telephone_row %}
    {#- A <label> pointing to the number, instead of the <fieldset>/<legend> of a compound field -#}
    {%- set row_class = ('crudit-ui-field' ~ (errors|length > 0 ? ' crudit-ui-field--invalid' : '') ~ ' ' ~ row_attr.class|default(''))|trim -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        <div class="crudit-ui-field__label-row">
            {{- form_label(form, null, {compound: false, id: form.number.vars.id}) -}}
            {{- block('crudit_ui_label_after') -}}
        </div>
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block collection_widget %}
    <div>
        <div class="card">
            <div class="card-body">
                {% if prototype is defined and not prototype.rendered %}
                    {% set prototype_rendered %}
                        <div class="row crudit-collection-ignore">
                            {% for column in prototype %}
                                {%- if column.vars.label is not same as(false) -%}
                                    <div class="{{ column.vars.row_attr.class|default('col') }}">
                                    <label {% with { attr: column.vars.label_attr } %}{{ block('attributes') }}{% endwith %}>
                                            {% with { label: column.vars.label, translation_domain: column.vars.translation_domain} %}
                                                {{- block('form_label_content') -}}
                                            {% endwith %}
                                    </label>
                                </div>
                                {%- endif -%}
                            {% endfor %}
                        </div>
                        <div class="row align-items-start">
                            {% set form_items = [prototype] %}
                            {% if prototype.children|length %}
                                {% set form_items = prototype.children %}
                            {% endif %}
                            {% for child in form_items|filter(child => not child.rendered) %}
                                {{- form_row(child, { label: false }) -}}
                            {% endfor %}
                        </div>
                    {% endset %}

                    {% set attr = attr|merge({
                        'data-prototype': prototype_rendered|e('html_attr'),
                    }) %}
                {% endif %}
                <div
                    {{ block('widget_container_attributes') }}
                    data-index="{{ form|length ? (form|last.vars.name + 1) : 0 }}"
                    data-name="{{ form.vars.prototype.vars.name }}"
                >
                    {% for row in form|filter(child => not child.rendered) %}
                        {% if not loop.first and row|length %}
                            <hr/>
                        {% endif %}
                        <div class="row crudit-collection-ignore">
                            {% for column in row %}
                                <div class="{{ column.vars.row_attr.class|default('col') }}">
                                    <label {% with { attr: column.vars.label_attr } %}{{ block('attributes') }}{% endwith %}>
                                        {%- if column.vars.label is not same as(false) -%}
                                            {% with { label: column.vars.label, translation_domain: column.vars.translation_domain} %}
                                                {{- block('form_label_content') -}}
                                            {% endwith %}
                                        {%- endif -%}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="row align-items-start">
                            {% set form_items = [row] %}
                            {% if row.children|length %}
                                {% set form_items = row.children %}
                            {% endif %}
                            {% for child in form_items|filter(child => not child.rendered) %}
                                {{- form_row(child, { label: false }) -}}
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="card-footer text-body-secondary">
                <button type="button" class="btn btn-sm btn-outline-success crudit-collection-add mx-auto"
                        data-target="#{{ id }}">
                    <i class="fa fa-plus pe-none"></i>&nbsp;{{ 'action.add'|trans }}
                </button>
            </div>
        </div>
    </div>
{% endblock %}
