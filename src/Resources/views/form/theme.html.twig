{#
 # Form theme of Crudit (lot 3.2.a): the inputs of CruditUiBundle (@LleCruditUi/form/theme.html.twig, no Bootstrap),
 # and the blocks of the Crudit form types. Registered in twig.form.resources (the Crudit types work in the forms of
 # the project), and imposed by the bricks whatever the global theme of the project:
 # {% form_theme form with ['@LleCrudit/form/theme.html.twig'] only %}.
 # The layout of a form (sections, grid, widths) is in brick/form/index.html.twig.
 #}
{% use '@LleCruditUi/form/theme.html.twig' %}

{#
 # Format helpers of the 1.x (classes crudit-upper-format, crudit-lower-format, crudit-email-format, crudit-ip-format
 # on a field): the controller input-format, which acts once the field is left (lot 3.2.b). No spell check on an
 # e-mail or an IP address, the keyboard of an e-mail address (an IP address keeps the keyboard of a text, which has
 # the point).
 #}
{%- block form_widget_simple -%}
    {%- set attr = crudit_form_format_attr(attr) -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = crudit_form_format_attr(attr) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{#
 # A checkbox with the option switch (SwitchExtension, a boolean guessed by Crudit): role="switch" here only, the switch
 # of CruditUiBundle; another theme keeps the checkbox. The attr of the project keeps its role.
 #}
{%- block checkbox_row -%}
    {%- if switch|default(false) %}{% set attr = {role: 'switch'}|merge(attr) %}{% endif -%}
    {{- parent() -}}
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- if switch|default(false) %}{% set attr = {role: 'switch'}|merge(attr) %}{% endif -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{# The help of the options tooltip, tooltip_html and tooltip_template: a button next to the label #}
{%- block crudit_ui_label_after -%}
    {%- if tooltip|default(null) or tooltip_html|default(null) or tooltip_template|default(null) -%}
        {{- include('@LleCrudit/brick/form/_tooltip.html.twig', {field: form}) -}}
    {%- endif -%}
{%- endblock -%}

{# An entity in a list with search (AutocompleteType): the list of CruditUiBundle, its choices asked to the server #}
{%- block autocomplete_widget -%}
    {{- block('crudit_ui_combobox_widget') -}}
{%- endblock autocomplete_widget -%}

{#
 # A translated field (GedmoTranslatableType): the tabs of CruditUiBundle, one per locale, the default one first. The
 # label points to the input of the default locale; the help (by default on a required field, which locale is required)
 # and the error of the field are attached to every input, the errors of a locale stay in its panel and mark its tab.
 #}
{%- block crudit_gedmo_translatable_row -%}
    {%- set crudit_invalid = errors|length > 0 or form|filter(child => child.vars.errors|length > 0)|length > 0 -%}
    {%- set row_class = ('crudit-ui-field' ~ (crudit_invalid ? ' crudit-ui-field--invalid' : '') ~ ' ' ~ row_attr.class|default(''))|trim -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {%- if label is not same as(false) -%}
            <div class="crudit-ui-field__label-row">
                {{- form_label(form, null, {compound: false, id: form[defaultlocale].vars.id}) -}}
                {{- block('crudit_ui_label_after') -}}
            </div>
        {%- endif -%}
        {#- The help and the error attached to the inputs, given by the row: form_widget() alone has none to point to -#}
        {{- form_widget(form, {crudit_described: (help is not empty or required ? [id ~ '_help'] : [])|merge(errors|length > 0 ? [id ~ '_error'] : [])}) -}}
        {#- Without a help of its own, a required field says which locale is required (as the 1.x) -#}
        {{- form_help(form, help is empty and required ? {help: crudit_gedmo_default_locale_helper(), translation_domain: false} : {}) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock crudit_gedmo_translatable_row -%}

{%- block crudit_gedmo_translatable_widget -%}
    {#- The name of the tablist: the label as form_label_content writes it (label_format, translated) -#}
    {%- if label is same as(false) and attr['aria-label'] is defined -%}
        {%- set crudit_name = attr['aria-label'] -%}
    {%- else -%}
        {%- set crudit_name = label is empty or label is same as(false) ? (label_format is not empty ? label_format|replace({'%name%': name, '%id%': id}) : name|humanize) : label -%}
        {%- set crudit_name = translation_domain is same as(false) ? crudit_name : crudit_name|trans(label_translation_parameters, translation_domain) -%}
    {%- endif -%}
    {#- Given by the row: the help (its own, or crudit_gedmo_default_locale_helper() on a required field), the error -#}
    {%- set crudit_described = crudit_described ?? [] -%}
    {%- set crudit_languages = [] -%}
    {%- for locale in locales -%}
        {%- set child = form[locale] -%}
        {%- set child_described = ((child.vars.attr['aria-describedby'] ?? '') ~ ' ' ~ crudit_described|join(' '))|trim -%}
        {%- set child_attr = child_described is empty ? child.vars.attr : child.vars.attr|merge({'aria-describedby': child_described}) -%}
        {%- if locale == defaultlocale -%}
            {#- Also pointed by the label of the field: named by its own label only, "Description (Français)" -#}
            {%- set child_attr = child_attr|merge({'aria-labelledby': child.vars.id ~ '_label'}) -%}
        {%- endif -%}
        {%- set crudit_languages = crudit_languages|merge([{
            code: locale,
            label: tablabels[locale],
            input_id: child.vars.id,
            input: form_widget(child, {attr: child_attr}),
            errors: form_errors(child),
            required: child.vars.required,
            empty: (child.vars.value is iterable ? '' : child.vars.value|default(''))|trim is empty,
            invalid: child.vars.errors|length > 0,
        }]) -%}
    {%- endfor -%}
    {{- include('@LleCruditUi/form/_translatable.html.twig', {
        id: id,
        label: crudit_name,
        languages: crudit_languages,
        class: attr.class|default(''),
    }, with_context: false) -}}
{%- endblock crudit_gedmo_translatable_widget -%}

{% block crudit_group_row %}
{% endblock %}

{% block crudit_group_label %}
{% endblock %}

{% block crudit_file_widget %}
    {% include '@LleCrudit/form/_file_widget.html.twig' %}
{% endblock %}

{#
 # A cron expression (CronExpressionType): a fieldset named by its legend, the widget of CruditUiBundle in the state read
 # from the value (crudit_cron_state); the text input is what is sent, the controls of the widget have no name.
 #}
{%- block crudit_cron_expression_row -%}
    {%- set row_class = ('crudit-ui-field crudit-ui-field__group' ~ (errors|length > 0 ? ' crudit-ui-field--invalid' : '') ~ ' ' ~ row_attr.class|default(''))|trim -%}
    <fieldset{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {%- if label is not same as(false) -%}
            <legend{% with {attr: label_attr|merge({class: ('crudit-ui-label ' ~ label_attr.class|default(''))|trim})} %}{{ block('attributes') }}{% endwith %}>
                {{- block('form_label_content') -}}
                {{- block('crudit_ui_required') -}}
            </legend>
        {%- endif -%}
        {{- block('crudit_ui_label_after') -}}
        {#- The help and the error attached to the controls, given by the row: form_widget() alone has none to point to -#}
        {{- form_widget(form, {crudit_described: (help is not empty ? [id ~ '_help'] : [])|merge(errors|length > 0 ? [id ~ '_error'] : [])}) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </fieldset>
{%- endblock crudit_cron_expression_row -%}

{%- block crudit_cron_expression_widget -%}
    {%- set crudit_described = crudit_described ?? [] -%}
    {{- include('@LleCruditUi/form/_cron.html.twig', {
        id: id ~ '_cron',
        input_id: id,
        input: block('form_widget_simple'),
        state: crudit_cron_state,
        describedby: crudit_described|join(' '),
        required: required,
        disabled: disabled,
        invalid: errors|length > 0,
    }, with_context: false) -}}
{%- endblock crudit_cron_expression_widget -%}

{% block crudit_telephone_widget %}
    {% include '@LleCrudit/form/_telephone_widget.html.twig' %}
{% endblock %}

{% block crudit_telephone_row %}
    {#- A <label> pointing to the number, instead of the <fieldset>/<legend> of a compound field -#}
    {%- set row_class = ('crudit-ui-field' ~ (errors|length > 0 ? ' crudit-ui-field--invalid' : '') ~ ' ' ~ row_attr.class|default(''))|trim -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        <div class="crudit-ui-field__label-row">
            {{- form_label(form, null, {compound: false, id: form.number.vars.id}) -}}
            {{- block('crudit_ui_label_after') -}}
        </div>
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block collection_widget %}
    <div>
        <div class="card">
            <div class="card-body">
                {% if prototype is defined and not prototype.rendered %}
                    {% set prototype_rendered %}
                        <div class="row crudit-collection-ignore">
                            {% for column in prototype %}
                                {%- if column.vars.label is not same as(false) -%}
                                    <div class="{{ column.vars.row_attr.class|default('col') }}">
                                    <label {% with { attr: column.vars.label_attr } %}{{ block('attributes') }}{% endwith %}>
                                            {% with { label: column.vars.label, translation_domain: column.vars.translation_domain} %}
                                                {{- block('form_label_content') -}}
                                            {% endwith %}
                                    </label>
                                </div>
                                {%- endif -%}
                            {% endfor %}
                        </div>
                        <div class="row align-items-start">
                            {% set form_items = [prototype] %}
                            {% if prototype.children|length %}
                                {% set form_items = prototype.children %}
                            {% endif %}
                            {% for child in form_items|filter(child => not child.rendered) %}
                                {{- form_row(child, { label: false }) -}}
                            {% endfor %}
                        </div>
                    {% endset %}

                    {% set attr = attr|merge({
                        'data-prototype': prototype_rendered|e('html_attr'),
                    }) %}
                {% endif %}
                <div
                    {{ block('widget_container_attributes') }}
                    data-index="{{ form|length ? (form|last.vars.name + 1) : 0 }}"
                    data-name="{{ form.vars.prototype.vars.name }}"
                >
                    {% for row in form|filter(child => not child.rendered) %}
                        {% if not loop.first and row|length %}
                            <hr/>
                        {% endif %}
                        <div class="row crudit-collection-ignore">
                            {% for column in row %}
                                <div class="{{ column.vars.row_attr.class|default('col') }}">
                                    <label {% with { attr: column.vars.label_attr } %}{{ block('attributes') }}{% endwith %}>
                                        {%- if column.vars.label is not same as(false) -%}
                                            {% with { label: column.vars.label, translation_domain: column.vars.translation_domain} %}
                                                {{- block('form_label_content') -}}
                                            {% endwith %}
                                        {%- endif -%}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="row align-items-start">
                            {% set form_items = [row] %}
                            {% if row.children|length %}
                                {% set form_items = row.children %}
                            {% endif %}
                            {% for child in form_items|filter(child => not child.rendered) %}
                                {{- form_row(child, { label: false }) -}}
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>
            <div class="card-footer text-body-secondary">
                <button type="button" class="btn btn-sm btn-outline-success crudit-collection-add mx-auto"
                        data-target="#{{ id }}">
                    <i class="fa fa-plus pe-none"></i>&nbsp;{{ 'action.add'|trans }}
                </button>
            </div>
        </div>
    </div>
{% endblock %}
