{# Back to the top (controller back-to-top): shown once the page has scrolled, hidden without JavaScript. #}
<button type="button" class="crudit-back-to-top" hidden data-controller="2lenet--crudit-bundle--back-to-top" data-action="2lenet--crudit-bundle--back-to-top#top">
    {{- ui_icon('arrow-up') -}}
    <span class="crudit-ui-visually-hidden">{{ 'crudit.layout.back_to_top'|trans(domain: 'LleCruditBundle') }}</span>
</button>
