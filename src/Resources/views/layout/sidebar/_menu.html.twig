{#
 # Items of the menu, from the providers (crudit.menu). Each element renders itself (its getTemplate()). The list is the
 # menu shown to the user (MenuBuilder): elements not granted, empty sub-menus, headings left alone and needless
 # separators are already removed.
 #}
<ul class="crudit-nav">
    {% for element in crudit_menu_items('menu_side') %}
        {% include element.template with {'element': element, 'where': 'menu-nav'} %}
    {% endfor %}
</ul>
