{#
 # Item of the menu without children: a link (LinkElement: route and parameters) or an external link
 # (ExternalLinkElement: address). Contract with the sidebar controller: `data-menu-kind="item"` and `data-menu-label`
 # on the <li> (filter of the menu), `aria-current="page"` on the link of the current page. `tooltip` (true by default,
 # false for the links of a sub-menu): the tooltip of the collapsed menu. A link that opens a new tab shows an icon,
 # announces it and has a safe `rel`.
 #}
{% set label = element.libelle|trans %}
{# The tooltip of the rail shows the badges after the label #}
{% set tooltip_text = ([label]|merge((element.badges ?? [])|map(badge => badge.libelle|trans)))|join(' · ') %}
{% set tooltip = tooltip is defined ? tooltip : true %}
{% set route = element.path ?? null %}
{% set url = route ? path(route.route, route.params) : (element.url ?? null) %}
{% set target = element.target ?? null %}
{% set link %}
    <a href="{{ url|default('#') }}" class="crudit-nav__link"
       {% if route and crudit_menu_active(element, app.request) %}aria-current="page"{% endif %}
       {% if target %}target="{{ target }}"{% endif %}
       {% if target == '_blank' %}rel="noopener noreferrer"{% endif %}>
        {% include '@LleCrudit/layout/sidebar/_item_content.html.twig' %}
        {% if target == '_blank' %}
            {{- ui_icon('external-link', 'crudit-nav__external') -}}
            <span class="crudit-ui-visually-hidden">&nbsp;{{ 'crudit.layout.new_tab'|trans(domain: 'LleCruditBundle') }}</span>
        {% endif %}
    </a>
{% endset %}
<li class="crudit-nav__item {{ element.cssClass|default('') }}" data-menu-kind="item" data-menu-label="{{ label }}">
    {% if tooltip %}
        <twig:LleCruditUi:Tooltip :text="tooltip_text" placement="beside">{{ link }}</twig:LleCruditUi:Tooltip>
    {% else %}
        {{ link }}
    {% endif %}
</li>
