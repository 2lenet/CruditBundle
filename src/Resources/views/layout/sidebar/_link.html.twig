{#
 # Template of LinkElement: a link, or a sub-menu when the element has children. Only the first level calls it; the
 # links of a sub-menu are rendered by their own template, without tooltip.
 #}
{% if element.children|length %}
    {% include '@LleCrudit/layout/sidebar/_submenu.html.twig' %}
{% else %}
    {% include '@LleCrudit/layout/sidebar/_item.html.twig' %}
{% endif %}
