{#
 # Layout of Crudit, extended by the base.html.twig of the projects. The skip links, the menu (#crudit-sidebar), then the
 # column of the content: the header (<header>), <main id="main">, the footer. The page gives the only <h1>.
 #
 # Language, direction and theme are on <html> (ui_lang(), ui_dir(), ui_theme() of CruditUiBundle): the page is shown
 # right to left and in the theme chosen from the first paint, without an inline script.
 #
 # The layout loads neither CSS nor JavaScript: the project loads ui.css of CruditUiBundle, then crudit.css, and the
 # Stimulus controllers in its blocks stylesheets and javascripts (UPGRADE-2.0.md, §2).
 #
 # Out of the block body, so that a project that rewrites it keeps them: the skip links, the toasts (flash messages),
 # the confirmation of the actions and the back to the top button.
 #}
<!DOCTYPE html>
{% set theme = ui_theme() %}
<html lang="{{ ui_lang() }}" dir="{{ ui_dir() }}"{% if theme %} data-theme="{{ theme }}"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block autorefresh %}{% endblock %}
    <title>{% block page_title %}{{ app_name ?? 'Crudit' }}{% endblock %}</title>
    {% block favicon %}
        {% set favicon = crudit_layout().favicon %}
        {% if favicon %}<link rel="icon" href="{{ asset(favicon) }}"{% if favicon|split('?')|first ends with '.svg' %} type="image/svg+xml"{% endif %}>{% endif %}
    {% endblock %}
    {% block stylesheets %}{% endblock %}
    {% block head_stylesheets %}{% endblock %}
    <script src="{{ asset('bundles/fosjsrouting/js/router.js') }}"></script>
    <script src="{{ path('fos_js_routing_js', {callback: 'fos.Router.setData'}) }}"></script>
    {% block javascripts %}{% endblock %}
    {% block head_javascript %}{% endblock %}
</head>

<body data-controller="2lenet--crudit-bundle--modal-bridge">
{% block skip_links %}
    {% include '@LleCrudit/layout/_skip_links.html.twig' %}
{% endblock %}

{% block body %}
    {% set ctrl = '2lenet--crudit-bundle--sidebar' %}
    <div class="crudit-shell" data-sidebar="{{ crudit_sidebar() }}" data-controller="{{ ctrl }}">
        <div id="crudit-sidebar" class="crudit-shell__sidebar crudit-sidebar" role="complementary" data-{{ ctrl }}-target="sidebar"
             aria-label="{{ 'crudit.layout.sidebar'|trans(domain: 'LleCruditBundle') }}"
             data-menu-label="{{ 'crudit.layout.main_menu'|trans(domain: 'LleCruditBundle') }}">
            <div class="crudit-sidebar__header">
                {% block brand %}
                    <a class="crudit-brand" href="/">
                        {% block logo %}
                            {% include '@LleCrudit/layout/sidebar/_logo.html.twig' %}
                        {% endblock %}
                    </a>
                {% endblock %}
                <twig:LleCruditUi:IconButton icon="close" :label="'crudit.layout.close_menu'|trans(domain: 'LleCruditBundle')" class="crudit-sidebar__close" data-action="{{ ctrl }}#close" data-2lenet--crudit-bundle--sidebar-target="close"/>
            </div>

            {% block menu_filter %}
                {% include '@LleCrudit/layout/sidebar/_filter.html.twig' %}
            {% endblock %}

            <nav id="main-nav" class="crudit-sidebar__nav" aria-label="{{ 'crudit.layout.main_menu'|trans(domain: 'LleCruditBundle') }}" tabindex="-1" data-{{ ctrl }}-target="nav">
                {% block side_header %}{% endblock %}
                {% block menu %}
                    {% include '@LleCrudit/layout/sidebar/_menu.html.twig' %}
                {% endblock %}
                {% block side_footer %}{% endblock %}
                <p class="crudit-sidebar__empty" hidden data-{{ ctrl }}-target="empty">{{ 'crudit.layout.filter_none'|trans(domain: 'LleCruditBundle') }}</p>
            </nav>

            {% block menu_toggle %}
                {% include '@LleCrudit/layout/sidebar/_toggle.html.twig' %}
            {% endblock %}
        </div>
        <div class="crudit-shell__backdrop" hidden aria-hidden="true" data-action="click->{{ ctrl }}#close" data-{{ ctrl }}-target="backdrop"></div>

        <div class="crudit-shell__body" data-{{ ctrl }}-target="body">
            <header class="crudit-shell__header">
                {% block header %}
                    <div class="crudit-header">
                        {% include '@LleCrudit/layout/header/_burger.html.twig' %}
                        {% block header_nav %}{% endblock %}
                        {% block header_right %}
                            {% include '@LleCrudit/layout/header/_actions.html.twig' %}
                        {% endblock %}
                    </div>
                {% endblock %}
            </header>

            <main id="main" class="crudit-shell__main" tabindex="-1">
                {% block main %}
                    {% block content %}{% endblock %}
                {% endblock main %}
            </main>

            {% block footer %}
                {# No footer without link, version nor date #}
                {% set layout = crudit_layout() %}
                {% if layout.footer_links or layout.version or layout.release_date %}
                    <footer class="crudit-footer">
                        {% include '@LleCrudit/layout/footer/_links.html.twig' %}
                        {% include '@LleCrudit/layout/footer/_version.html.twig' %}
                    </footer>
                {% endif %}
            {% endblock %}
        </div>
    </div>
{% endblock %}

{% block toasts %}
    {% include '@LleCrudit/layout/_toasts.html.twig' %}
{% endblock %}

{% block modal_confirmation %}
    {% include '@LleCrudit/modal/_confirm.html.twig' with {id: 'crudit-confirm'} only %}
{% endblock %}

{% block scroll_top %}
    {% include '@LleCrudit/layout/_back_to_top.html.twig' %}
{% endblock %}

{% block body_javascript %}{% endblock %}
</body>
</html>
