{% extends "@LleCrudit/filter/type/_base_filter.html.twig" %}

{# All / Yes / No, sent as `all`, `true` or `false`. #}
{% block input %}
    <div class="crudit-ui-filter-field__segmented">
        {% for option, text in {'all': 'crudit.boolean.all', 'true': 'crudit.boolean.yes', 'false': 'crudit.boolean.no'} %}
            <label class="crudit-ui-filter-field__segment">
                <input class="crudit-ui-filter-field__radio" type="radio" name="{{ id }}_value" value="{{ option }}"{{ (value ?: 'all') == option ? ' checked' : '' }}>
                <span>{{ text|trans({}, 'LleCruditBundle') }}</span>
            </label>
        {% endfor %}
    </div>
{% endblock %}
