{#
 # The frame of a filter that has a template of its own (`setTemplate()`, or a filter type of a project): the label, then
 # one frame [condition | input], as a Filter:Field of CruditUiBundle draws it. The filters of the types of the bundle
 # that keep their default template are drawn by that component, not by this template (FilterViewBuilder).
 #
 # The variables are those of the 1.x (`id`: the name of the filter, `data`, `filter`, `filtertype`, `view`) and `operators`,
 # `operator`, `value`, `to`, `choices` (ready to use). Blocks: `operator` (the condition), `input` (the input, which a type
 # replaces). The inputs are sent by the form of the bar under `<id>_value`, `<id>_op` and `<id>_to`: keep these names.
 #}
<div class="crudit-ui-filter-field__label">{{ filter.label|trans(domain=view.config.translation_domain) }}</div>
<div class="crudit-ui-filter-field__control">
    {% block operator %}
        {%- if operators|length > 1 -%}
            <twig:LleCruditUi:Filter:Operator :name="id" :label="filter.label|trans(domain=view.config.translation_domain)" :operators="operators" :current="operator" />
        {%- elseif operators|length == 1 -%}
            <input type="hidden" name="{{ id }}_op" value="{{ (operators|first).value }}">
        {%- endif -%}
    {% endblock %}
    <div class="crudit-ui-filter-field__input">
        {% block input %}
            <input type="text" class="crudit-ui-filter-field__text" name="{{ id }}_value" value="{{ value }}" autocomplete="off" aria-label="{{ filter.label|trans(domain=view.config.translation_domain) }}">
        {% endblock %}
    </div>
</div>
