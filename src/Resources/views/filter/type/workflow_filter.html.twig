{% extends "@LleCrudit/filter/type/_base_filter.html.twig" %}

{# A list of boxes: `<id>_value[]`. `choices`: the list of {value, label}. #}
{% block input %}
    {% set chosen = value ? value|split(',') : [] %}
    <ul class="crudit-ui-filter-field__choices">
        {% for choice in choices %}
            <li>
                <label class="crudit-ui-filter-field__choice">
                    <input type="checkbox" name="{{ id }}_value[]" value="{{ choice.value }}"{{ choice.value in chosen ? ' checked' : '' }}>
                    <span>{{ choice.label }}</span>
                </label>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
