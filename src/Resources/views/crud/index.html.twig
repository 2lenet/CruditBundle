{% extends 'base.html.twig' %}

{# <title>: "Page – Application" (the page first: the tab and the screen reader give it before the application) #}
{% block page_title %}
    {%- set application = app_name ?? 'Crudit' -%}
    {%- set mainView = views|first -%}
    {%- set page = mainView and (mainView.config.title ?? null) and (mainView.config.translation_domain ?? null)
        ? mainView.config.title|trans({'%entity%': mainView.data.entity|default('')}, mainView.config.translation_domain)
        : null -%}
    {{- page ? page ~ ' – ' ~ application : application -}}
{% endblock %}

{% block content %}
    {% include '@LleCrudit/crud/_bricks.html.twig' with {'views': views } %}
{% endblock %}
