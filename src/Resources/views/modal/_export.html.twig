{% extends '@LleCrudit/modal/_base_modal.html.twig' %}

{% block header %}
    {{ 'crudit.modal.export.message'|trans({}, 'LleCruditBundle') }}
{% endblock %}
{% block body %}
    <form
        id="form_{{ id }}"
        method="GET"
        action="{{ action.url ?? path(action.path.route, action.path.params) }}"
    >
        {% if action.config.export is defined and action.config.export is iterable %}
            <select name="format" class="form-select">
                {% for format in action.config.export %}
                    <option
                        value="{{ format }}">{{ ('export.' ~ format) | trans(domain=view.config.translation_domain) }}</option>
                {% endfor %}
            </select>
        {% else %}
            {{ 'crudit.modal.export.notConfigured'|trans({}, 'LleCruditBundle') }}
        {% endif %}
    </form>
{% endblock %}
{% block footer %}
    <twig:LleCruditUi:Button commandfor="{{ id }}" command="close">{{ 'crudit.modal.cancel'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
    <twig:LleCruditUi:Button variant="primary" type="submit" form="form_{{ id }}" icon="download">{{ 'crudit.modal.export.action'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
{% endblock %}
