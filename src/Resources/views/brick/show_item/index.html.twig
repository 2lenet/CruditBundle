{#
 # Record (ShowBrick, lot 3.3.a; maquette 03-fiche): under the header of the page (brick/links: title, status,
 # subtitle, dates), an alert (view.data.alert, CrudConfigInterface::getShowAlert(): a text, never the colour alone),
 # the key information (view.data.highlights), then the sections (view.data.sections, ShowFactory): the fields of no
 # group in a card without title, each group in a Disclosure of CruditUiBundle (a button in a <h2>). The sections are
 # in 2 columns on a wide screen as soon as there are 2 (view.data.section_columns), a wide one alone on its line
 # (getShowWideSections()); the fields of a section on a grid of 1 to 4 columns (brick/show_item/_fields). The class of getCssClass() of the element stays on the record, as in the 1.x.
 #}
{% block autorefresh %}
    {% if view.data.auto_refresh is defined and view.data.auto_refresh %}
        <meta http-equiv="refresh" content="{{ view.data.auto_refresh }}">
    {% endif %}
{% endblock %}
{%- set show_domain = view.config.translation_domain -%}
{%- set show_resource = view.data.resource -%}
<div class="crudit-show {{ show_resource.resource.getCssClass ?? '' }}"{% if show_resource %} id="{{ show_resource.id }}"{% endif %}>
    {%- if view.data.alert -%}
        {%- set show_alert = view.data.alert.message|trans(view.data.alert.parameters, show_domain) -%}
        <twig:LleCruditUi:Alert tone="{{ view.data.alert.tone }}" class="crudit-show__alert">{{ show_alert }}</twig:LleCruditUi:Alert>
    {%- endif -%}

    {%- if view.data.highlights is not empty -%}
        <dl class="crudit-show-highlights">
            {%- for show_field in view.data.highlights -%}
                <div class="crudit-show-highlights__item">
                    <dt class="crudit-show-highlights__label">{{ show_field.field.label|trans(domain: show_domain) }}</dt>
                    <dd class="crudit-show-highlights__value">{{ include('@LleCrudit/brick/show_item/_value.html.twig', {field: show_field, resource: show_resource}, with_context: false) }}</dd>
                </div>
            {%- endfor -%}
        </dl>
    {%- endif -%}

    {%- if view.data.sections is not empty -%}
        <div class="crudit-show-sections crudit-show-sections--{{ view.data.section_columns }}">
            {%- for show_section in view.data.sections -%}
                {#- Rendered first: in the blocks of the component, its props (title, open, id) hide the variables -#}
                {%- set show_fields = include('@LleCrudit/brick/show_item/_fields.html.twig', {
                    section: show_section,
                    domain: show_domain,
                    resource: show_resource,
                    config: view.config,
                }, with_context: false) -%}
                {%- if show_section.title is null -%}
                    <div class="crudit-show-section crudit-show-section--plain">{{ show_fields }}</div>
                {%- else -%}
                    <twig:LleCruditUi:Disclosure
                        title="{{ show_section.title|trans(domain: show_domain) }}"
                        :open="show_section.open"
                        :level="2"
                        id="{{ show_section.id }}"
                        class="crudit-show-section{{ show_section.wide ? ' crudit-show-section--wide' }}"
                    >{{ show_fields }}</twig:LleCruditUi:Disclosure>
                {%- endif -%}
            {%- endfor -%}
        </div>
    {%- endif -%}
</div>
