{#
 # Form of a CRUD (FormBrick), lot 3.2.a. The theme of Crudit is imposed (crudit_form_themes(): the global themes of the
 # project except a layout like bootstrap_5_layout, so CKEditor, Vich and the blocks of the project keep working): labels above, help and errors attached, required fields explained above the form.
 # The fields are on a grid of at most `view.data.columns` per line (FormConfig::setColumns(), else
 # CrudConfigInterface::getFormColumns(), lle_crudit.form_columns: 4); a field takes 1 column, 2 or the whole line
 # (option span). A GroupType opens a section (fieldset with a title) up to the next one, with its own number of
 # columns (option columns). The title of a section is a <h3> under the title of the form, else a <h2> (a project that
 # empties the block form_title but gives a title keeps <h3>). A sub-form (a compound field of the form type) is laid
 # out field by field on the grid, its own errors (a constraint on the object) on a line above its fields; its option
 # span is refused (crudit_form_check_flattened()). The titles, descriptions and tooltips are translated in the
 # translation_domain of the field, as the labels.
 # Option horizontalForm (FormConfig::new(['horizontalForm' => true]), the form to add a line under a sublist): the
 # fields side by side on one line, the buttons at its end.
 # As in the 1.x, autocomplete="off" on the form and autocomplete="new-password" on each input typed in (not on a
 # checkbox, a list or a compound field: crudit_form_field_attr()), unless the field sets its own (attr.autocomplete).
 # Blocks kept for the projects: form_title, form_buttons.
 #}
{% if view.role is not defined or not view.role or is_granted(view.role, view.data.resource) %}
    {% set form = view.data.form %}
    {% form_theme form with crudit_form_themes() only %}
    {% set columns = view.data.columns|default(4) %}
    {% set section_level = view.data.title is defined and view.data.title ? 3 : 2 %}

    <div class="crudit-form{% if view.data.options.horizontalForm ?? false %} crudit-form--horizontal{% endif %}">
        {% if view.data.title is defined and view.data.title %}
            {% block form_title %}
                <h2 class="crudit-form__title{% if view.data.titleCss is defined and view.data.titleCss %} {{ view.data.titleCss }}{% endif %}">
                    {{ view.data.title|trans }}
                </h2>
            {% endblock %}
        {% endif %}

        {% set form_attributes = {class: 'crudit-form__form', novalidate: 'novalidate', autocomplete: 'off'} %}
        {% if view.id is defined and view.id %}
            {% set form_attributes = form_attributes|merge({id: view.id ~ '-' ~ form.vars.name}) %}
        {% endif %}

        {{ form_start(form, {attr: form_attributes}) }}
        {% if crudit_form_has_required(form) %}
            <p class="crudit-form__legend">{{ 'crudit.form.required_legend'|trans({}, 'LleCruditBundle') }}</p>
        {% endif %}
        {{ form_errors(form) }}

        {# open: none, grid (fields before the first section) or section #}
        {% set open = 'none' %}
        {% for field in form %}
            {% if field.vars.isGroup ?? false %}
                {% do field.setRendered %}
                {% if open == 'grid' %}</div>{% elseif open == 'section' %}</div></fieldset>{% endif %}
                <fieldset id="{{ field.vars.id }}" class="crudit-form-section{% if field.vars.attr.class is defined and field.vars.attr.class %} {{ field.vars.attr.class }}{% endif %}">
                    <legend class="crudit-form-section__legend">
                        <h{{ section_level }} class="crudit-form-section__title">{{ field.vars.translation_domain is same as(false) ? field.vars.label : field.vars.label|trans(field.vars.label_translation_parameters|default({}), field.vars.translation_domain) }}</h{{ section_level }}>
                    </legend>
                    {% if field.vars.description %}
                        <p class="crudit-form-section__description">{{ field.vars.translation_domain is same as(false) ? field.vars.description : field.vars.description|trans({}, field.vars.translation_domain) }}</p>
                    {% endif %}
                    <div class="crudit-form-grid crudit-form-grid--{{ field.vars.columns ?? columns }}">
                {% set open = 'section' %}
            {% else %}
                {% if open == 'none' %}
                    <div class="crudit-form-grid crudit-form-grid--{{ columns }}">
                    {% set open = 'grid' %}
                {% endif %}
                {% if crudit_form_flattened(field) %}
                    {% do crudit_form_check_flattened(field) %}
                    {% if field.vars.errors|length > 0 %}
                        <div class="crudit-form-field crudit-form-field--span-full">{{ form_errors(field) }}</div>
                    {% endif %}
                    {% for subfield in field %}
                        {% do crudit_form_field_deprecations(subfield) %}
                        {{ form_row(subfield, {attr: crudit_form_field_attr(subfield)}) }}
                    {% endfor %}
                    {% do field.setRendered %}
                {% else %}
                    {% do crudit_form_field_deprecations(field) %}
                    {{ form_row(field, {attr: crudit_form_field_attr(field)}) }}
                {% endif %}
            {% endif %}
        {% endfor %}
        {% if open == 'grid' %}</div>{% elseif open == 'section' %}</div></fieldset>{% endif %}

        {% block form_buttons %}
            {% if view.data.cancel_path %}
                {% set cancelHref = path(view.data.cancel_path.route, view.data.cancel_path.params) %}
            {% elseif view.data.back_url is defined and view.data.back_url %}
                {% set cancelHref = view.data.back_url %}
            {% else %}
                {% set cancelHref = path(view.data.default_path.route) %}
            {% endif %}
            <div class="crudit-form__actions">
                <twig:LleCruditUi:Button href="{{ cancelHref }}">{{ 'crudit.action.cancel'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
                <twig:LleCruditUi:Button type="submit" variant="primary">{{ 'crudit.action.save'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
            </div>
        {% endblock %}
        {{ form_end(form) }}
    </div>
{% endif %}
