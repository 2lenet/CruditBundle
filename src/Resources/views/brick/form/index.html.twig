{#
 # Form of a CRUD (FormBrick), lot 3.2.a. The theme of Crudit is imposed (`only`: not the global theme of the project,
 # often bootstrap_5_layout): labels above, help and errors attached, required fields explained above the form.
 # The fields are on a grid of at most `view.data.columns` per line (FormConfig::setColumns(), else
 # CrudConfigInterface::getFormColumns(), lle_crudit.form_columns: 4); a field takes 1 column, 2 or the whole line
 # (option span). A GroupType opens a section (fieldset with a <h2> title) up to the next one, with its own number of
 # columns (option columns). A sub-form (a compound field of the form type) is laid out field by field on the grid.
 # Option horizontalForm (FormConfig::new(['horizontalForm' => true]), the form to add a line under a sublist): the
 # fields side by side on one line, the buttons at its end.
 # Blocks kept for the projects: form_title, form_buttons.
 #}
{% if view.role is not defined or not view.role or is_granted(view.role, view.data.resource) %}
    {% set form = view.data.form %}
    {% form_theme form with ['@LleCrudit/form/theme.html.twig'] only %}
    {% set columns = view.data.columns|default(4) %}
    {# Compound fields shown as one input (their own widget), not laid out field by field #}
    {% set widget_prefixes = ['choice', 'collection', 'date', 'time', 'datetime', 'dateinterval', 'birthday', 'week', 'repeated', 'vich_file', 'vich_image'] %}

    <div class="crudit-form{% if view.data.options.horizontalForm ?? false %} crudit-form--horizontal{% endif %}">
        {% if view.data.title is defined and view.data.title %}
            {% block form_title %}
                <h2 class="crudit-form__title{% if view.data.titleCss is defined and view.data.titleCss %} {{ view.data.titleCss }}{% endif %}">
                    {{ view.data.title|trans }}
                </h2>
            {% endblock %}
        {% endif %}

        {% set form_attributes = {class: 'crudit-form__form', novalidate: 'novalidate'} %}
        {% if view.id is defined and view.id %}
            {% set form_attributes = form_attributes|merge({id: view.id ~ '-' ~ form.vars.name}) %}
        {% endif %}

        {% set has_required = form.children|filter(child => child.vars.required and 'hidden' not in child.vars.block_prefixes and not (child.vars.isGroup ?? false) and child.vars.name != '_token')|length > 0 %}

        {{ form_start(form, {attr: form_attributes}) }}
        {% if has_required %}
            <p class="crudit-form__legend">{{ 'crudit.form.required_legend'|trans({}, 'LleCruditBundle') }}</p>
        {% endif %}
        {{ form_errors(form) }}

        {# open: none, grid (fields before the first section) or section #}
        {% set open = 'none' %}
        {% for field in form %}
            {% if field.vars.isGroup ?? false %}
                {% do field.setRendered %}
                {% if open == 'grid' %}</div>{% elseif open == 'section' %}</div></fieldset>{% endif %}
                <fieldset id="{{ field.vars.id }}" class="crudit-form-section{% if field.vars.attr.class is defined and field.vars.attr.class %} {{ field.vars.attr.class }}{% endif %}">
                    <legend class="crudit-form-section__legend">
                        <h2 class="crudit-form-section__title">{{ field.vars.label|trans }}</h2>
                    </legend>
                    {% if field.vars.description %}
                        <p class="crudit-form-section__description">{{ field.vars.description|trans }}</p>
                    {% endif %}
                    <div class="crudit-form-grid crudit-form-grid--{{ field.vars.columns ?? columns }}">
                {% set open = 'section' %}
            {% else %}
                {% if open == 'none' %}
                    <div class="crudit-form-grid crudit-form-grid--{{ columns }}">
                    {% set open = 'grid' %}
                {% endif %}
                {% set prefixes = field.vars.block_prefixes %}
                {% if field.vars.compound and field.children|length > 0
                    and prefixes|filter(p => p in widget_prefixes or p starts with 'crudit_')|length == 0 %}
                    {% for subfield in field %}
                        {{ form_row(subfield) }}
                    {% endfor %}
                    {% do field.setRendered %}
                {% else %}
                    {{ form_row(field) }}
                {% endif %}
            {% endif %}
        {% endfor %}
        {% if open == 'grid' %}</div>{% elseif open == 'section' %}</div></fieldset>{% endif %}

        {% block form_buttons %}
            {% if view.data.cancel_path %}
                {% set cancelHref = path(view.data.cancel_path.route, view.data.cancel_path.params) %}
            {% elseif view.data.back_url is defined and view.data.back_url %}
                {% set cancelHref = view.data.back_url %}
            {% else %}
                {% set cancelHref = path(view.data.default_path.route) %}
            {% endif %}
            <div class="crudit-form__actions">
                <twig:LleCruditUi:Button href="{{ cancelHref }}">{{ 'crudit.action.cancel'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
                <twig:LleCruditUi:Button type="submit" variant="primary">{{ 'crudit.action.save'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
            </div>
        {% endblock %}
        {{ form_end(form) }}
    </div>
{% endif %}
