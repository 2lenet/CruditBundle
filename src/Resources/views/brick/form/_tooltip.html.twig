{#
 # Help of a field (options tooltip, tooltip_html, tooltip_template), next to its label: a button that opens it
 # (Toggletip of CruditUiBundle), reachable on a touch screen. Variable: field (the FormView of the field).
 #}
{%- set vars = field.vars -%}
{%- if vars.tooltip|default(null) or vars.tooltip_html|default(null) or vars.tooltip_template|default(null) -%}
    {%- set field_label = vars.label is empty ? vars.name|humanize : (vars.translation_domain is same as(false) ? vars.label : vars.label|trans(vars.label_translation_parameters|default({}), vars.translation_domain)) -%}
    <twig:LleCruditUi:Toggletip id="{{ vars.id }}_tooltip" label="{{ 'crudit.form.help_on'|trans({'%label%': field_label}, 'LleCruditBundle') }}">
        {%- if vars.tooltip|default(null) -%}
            {{ vars.tooltip|trans }}
        {%- elseif vars.tooltip_html|default(null) -%}
            {{ vars.tooltip_html|raw }}
        {%- else -%}
            {% include vars.tooltip_template %}
        {%- endif -%}
    </twig:LleCruditUi:Toggletip>
{%- endif -%}
