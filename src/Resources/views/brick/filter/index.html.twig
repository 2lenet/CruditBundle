{#
 # The filters of a list: the Filter:Bar of CruditUiBundle, fed by FilterViewBuilder (`view.data.bar`; the search is not a
 # filter of Crudit, so none). The filters are a GET form; their state is kept in the session (FilterState), so a list
 # found again after a record is still filtered.
 #}
{% set bar = view.data.bar %}
<twig:LleCruditUi:Filter:Bar :id="bar.id" :label="bar.label" :filters="bar.filters" :resetUrl="bar.resetUrl" :applyName="bar.applyName" />
