{#
 # One action of the bar of the header: a Button of CruditUiBundle (an IconButton with setHideLabel() and an icon),
 # at its variant, the primary one in primary. A disabled action, one with a modal, a confirmation or a print is a
 # button (crudit_action_href(), crudit_action_attributes()), else a link.
 # Variables: item (ActionView), action, view, reason_id (the reason that describes a disabled action), extra_attributes.
 #}
{% block action %}
    {%- set action_attributes = crudit_action_attributes(item, view.config.translation_domain, reason_id ?? null)|merge(extra_attributes ?? {}) -%}
    {%- set action_label = action.label|trans(domain: action.translationDomain ?? view.config.translation_domain) -%}
    {%- if action.hideLabel and action.icon -%}
        {% component 'LleCruditUi:IconButton' with {icon: action.icon.icon, label: action_label, href: crudit_action_href(item)}|merge(action_attributes) %}{% endcomponent %}
    {%- else -%}
        {% component 'LleCruditUi:Button' with {variant: item.variant, icon: action.icon.icon ?? null, href: crudit_action_href(item)}|merge(action_attributes) %}
            {% block content %}{{ action_label }}{% endblock %}
        {% endcomponent %}
    {%- endif -%}
{% endblock %}
