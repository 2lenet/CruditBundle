{#
 # A DropdownAction in the bar of the header: a Dropdown of CruditUiBundle at its label, its icon and its variant, its
 # actions in a Menu, a group with a heading (a string key) in a MenuGroup (actions/_menu).
 # Variables: item (ActionView), action, view.
 #}
{% set dropdown_groups = item.groups %}
<twig:LleCruditUi:Dropdown :label="action.label|trans(domain: action.translationDomain ?? view.config.translation_domain)" :icon="action.icon.icon ?? null" :variant="item.variant">
    <twig:LleCruditUi:Menu>
        {{- include('@LleCrudit/brick/links/actions/_menu.html.twig', {groups: dropdown_groups, view: view, mobile_only: false}, with_context: false) -}}
    </twig:LleCruditUi:Menu>
</twig:LleCruditUi:Dropdown>
