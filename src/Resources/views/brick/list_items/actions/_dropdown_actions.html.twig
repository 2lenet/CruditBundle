{#
 # The menu of a line: a Dropdown of CruditUiBundle, an icon button named "More actions for Bob", floating (inside a
 # table that scrolls), its actions as in the menu "More" of the header (brick/links/actions/_menu: MenuItem, reason,
 # danger, a DropdownAction as a group).
 # Variables: row_actions (RowActions), line, view.
 #}
{% set row_menu = row_actions.menu %}
<twig:LleCruditUi:Dropdown iconOnly floating size="small" :label="'crudit.action.more_for'|trans({'%entity%': line.resource}, 'LleCruditBundle')">
    <twig:LleCruditUi:Menu>
        {{- include('@LleCrudit/brick/links/actions/_menu.html.twig', {groups: row_menu, view: view, mobile_only: false}, with_context: false) -}}
    </twig:LleCruditUi:Menu>
</twig:LleCruditUi:Dropdown>
