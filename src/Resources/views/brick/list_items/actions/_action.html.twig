{#
 # The main action of a line: an IconButton of CruditUiBundle, small, named after the action and the line
 # ("Edit Bob": crudit.action.named, its label and the line). A disabled action keeps the focus (aria-disabled), described
 # by its reason (reason_id).
 # Variables: item (ActionView), action, line, view, reason_id.
 #}
{% block action %}
    {%- set action_label = 'crudit.action.named'|trans({
        '%action%': action.label|trans(domain: action.translationDomain ?? view.config.translation_domain),
        '%entity%': line.resource,
    }, 'LleCruditBundle') -%}
    {% component 'LleCruditUi:IconButton' with {
        icon: action.icon.icon ?? 'edit',
        label: action_label,
        size: 'small',
        href: crudit_action_href(item),
    }|merge(crudit_action_attributes(item, view.config.translation_domain, reason_id ?? null)) %}{% endcomponent %}
{% endblock %}
