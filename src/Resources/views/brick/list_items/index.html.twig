{#
 # The list: the Table of CruditUiBundle, fed by crudit_table() (TableViewBuilder: columns, rows, groups, totals, sort,
 # actions). A project puts a text above the table in the block `before`. The pager (3.1.d), the selection and the batch actions (3.1.c) and the filters (3.1.e) follow in their lots.
 #}
{% block autorefresh %}
    {% if view.data.auto_refresh is defined and view.data.auto_refresh %}
        <meta http-equiv="refresh" content="{{ view.data.auto_refresh }}">
    {% endif %}
{% endblock %}

{% block before %}{% endblock %}

{% set table = crudit_table(view) %}
<twig:LleCruditUi:Table
    :id="table.id"
    :caption="table.caption"
    :columns="table.columns"
    :rows="table.rows"
    :groups="table.groups"
    :totals="table.totals"
    :sort="table.sort"
    :sortable="table.sortable"
>
    <twig:block name="footer">
        {% include '@LleCrudit/brick/list_items/_pager.html.twig' %}
    </twig:block>
</twig:LleCruditUi:Table>
{% for modal in table.modals %}
    {% include modal.template with {action: modal.action, id: modal.id, line: modal.line, view: view} %}
{% endfor %}
