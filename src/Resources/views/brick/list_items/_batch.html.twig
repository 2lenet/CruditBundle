{#
 # The batch actions of a list: the SelectionBar of CruditUiBundle, shown when a row is checked. It gives the selection
 # to the action: `ids` (separated by commas) and `all_page` (1 when the whole list is selected, not only the page),
 # in the address of a link, or in the fields `ids` and `all_page` of the form of the action (a dialog). The dialog of an
 # action with its own template (`setModal()`) is fed when it opens: its fields and forms marked
 # `data-selection-field="ids"` / `"all_page"` are filled, its links marked `data-selection-link` get the selection in
 # their address, and `data-ids` / `data-all-page` are set on the dialog (event `crudit-ui:selection` for a script).
 # The button of an action with `setTemplate()` is that template, in place of the button of the bar: it opens the
 # dialog of the action with `commandfor="{{ dialog }}" command="show-modal"` (a modal or a form), or is a link with
 # `data-action="click->2lenet--crudit-ui-bundle--selection-bar#fill"`. Variables of the templates (button, modal):
 # action, params, form, view, list, item (the data of the action: id, label, url…), dialog (its id).
 # An action `setHideLabel()` with an icon shows the icon, its label stays for the screen readers. `setCssClass()` has
 # no effect (`setVariant()`).
 # Variables: list (crudit_table(view): selectable, batch, total, id; not `table`: the component SelectionBar has a prop of that name, which its blocks would see), view. The actions are those of `setIsBatch()`.
 #}
{% if list.selectable %}
    {% set fill = '2lenet--crudit-ui-bundle--selection-bar#fill' %}
    <twig:LleCruditUi:SelectionBar :table="list.id" :total="list.total">
        <twig:block name="actions">
            {% for item in list.batch %}
                {% set dialog = item.id %}
                {% if item.template %}
                    {% include item.template with {action: item.action, params: item.params, form: item.form, view: view, list: list, item: item, dialog: dialog} %}
                {% elseif item.kind == 'link' %}
                    <twig:LleCruditUi:Button :href="item.url" :variant="item.variant" :icon="item.icon" size="small" data-action="click->{{ fill }}" {{ ...(item.target ? {target: item.target} : {}) }}>
                        {%- if item.hideLabel and item.icon %}<span class="crudit-ui-visually-hidden">{{ item.label }}</span>{% else %}{{ item.label }}{% endif -%}
                    </twig:LleCruditUi:Button>
                {% else %}
                    <twig:LleCruditUi:Button :variant="item.variant" :icon="item.icon" size="small" commandfor="{{ dialog }}" command="show-modal" data-action="click->2lenet--crudit-ui-bundle--selection-bar#fillDialog">
                        {%- if item.hideLabel and item.icon %}<span class="crudit-ui-visually-hidden">{{ item.label }}</span>{% else %}{{ item.label }}{% endif -%}
                    </twig:LleCruditUi:Button>
                {% endif %}
            {% endfor %}
        </twig:block>
        <twig:block name="after">
            {% for item in list.batch %}
                {% set dialog = item.id %}
                {% if item.kind == 'form' %}
                    {% set form = item.form %}
                    {% form_theme form with ['@LleCrudit/form/theme.html.twig'] only %}
                    <twig:LleCruditUi:Dialog id="{{ dialog }}" :title="item.label">
                        <twig:block name="content">
                            {{ form_start(form, {action: item.url, attr: {id: dialog ~ '-form', novalidate: 'novalidate', autocomplete: 'off', 'data-action': 'submit->' ~ fill}}) }}
                            {% for field in form.children %}
                                {% if field.vars.name in ['ids', 'all_page'] %}
                                    {{ form_widget(field, {attr: {'data-selection-field': field.vars.name}}) }}
                                {% elseif field.vars.name != '_token' %}
                                    {% do crudit_form_field_deprecations(field) %}
                                    {{ form_row(field) }}
                                {% endif %}
                            {% endfor %}
                            {{ form_rest(form) }}
                            {{ form_end(form, {render_rest: false}) }}
                        </twig:block>
                        <twig:block name="footer">
                            <twig:LleCruditUi:Button variant="ghost" data-action="2lenet--crudit-ui-bundle--dialog#dismiss">{{ 'crudit.modal.cancel'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
                            <twig:LleCruditUi:Button type="submit" variant="primary" form="{{ dialog }}-form">{{ 'crudit.modal.validate'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
                        </twig:block>
                    </twig:LleCruditUi:Dialog>
                {% elseif item.kind == 'confirm' %}
                    <twig:LleCruditUi:Dialog id="{{ dialog }}" :title="item.label" :description="item.confirmText">
                        <twig:block name="footer">
                            <twig:LleCruditUi:Button variant="ghost" data-action="2lenet--crudit-ui-bundle--dialog#dismiss" autofocus>{{ 'crudit.modal.cancel'|trans({}, 'LleCruditBundle') }}</twig:LleCruditUi:Button>
                            <twig:LleCruditUi:Button :href="item.url" :variant="item.variant == 'secondary' ? 'primary' : item.variant" data-action="click->{{ fill }}">{{ item.label }}</twig:LleCruditUi:Button>
                        </twig:block>
                    </twig:LleCruditUi:Dialog>
                {% elseif item.kind == 'modal' %}
                    {# the same variables as the modal of a row, plus the view and the data of the action #}
                    {% include item.modal with {action: item.action, id: dialog, params: item.params, view: view, list: list, item: item} %}
                {% endif %}
            {% endfor %}
        </twig:block>
    </twig:LleCruditUi:SelectionBar>
{% endif %}
