{#
 # The actions of a line of a list (list_items, sublist_items: RowActions.vue of the crudit-v2 mockup), sorted by
 # PageActionsBuilder::buildRow() (crudit_row_actions()): the edition as an icon button (actions/_action), the
 # others in the menu of the line, named after it (actions/_dropdown_actions); then the dialogs of the actions with a
 # modal (modal_<id of the action><id of the line>). Lot 3.1.b puts it in the table.
 # Variables: line (the line: its resource, its id), view.
 #}
{% set row_actions = crudit_row_actions(view.config.actions, line.resource, line.id) %}
<td>
    {% block items_actions %}
        <div class="crudit-row-actions">
            {%- if row_actions.main -%}
                {{ include('@LleCrudit/brick/list_items/actions/_actions.html.twig', {item: row_actions.main, line: line, view: view}, with_context: false) }}
            {%- endif -%}
            {%- if row_actions.others -%}
                {{ include('@LleCrudit/brick/list_items/actions/_dropdown_actions.html.twig', {row_actions: row_actions, line: line, view: view}, with_context: false) }}
            {%- endif -%}
        </div>
    {% endblock %}
    {%- for item in row_actions.modals -%}
        {% include item.action.modal with {action: item.action, id: item.modalId, params: item.params} %}
    {%- endfor -%}
</td>
